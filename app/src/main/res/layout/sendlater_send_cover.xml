<?xml version="1.0" encoding="utf-8"?>
<!-- send-lock-cover: opaque, input-eating cover over the WebView while a scheduled send runs over
     the keyguard. Shows the app icon, a fixed title and the masked number only: never message
     text, a name or other threads. Screen readers see this view, not the page under it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sendlater_send_cover"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101418"
    android:clickable="true"
    android:longClickable="true"
    android:focusable="false"
    android:importantForAccessibility="yes"
    android:contentDescription="@string/sendlater_send_cover_title">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:importantForAccessibility="noHideDescendants">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@android:drawable/sym_action_chat"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/sendlater_send_cover_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/sendlater_send_cover_title"
            android:textColor="#FFE8EAED"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/sendlater_send_cover_recipient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FF9AA0A6"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
