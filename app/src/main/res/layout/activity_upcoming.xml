<?xml version="1.0" encoding="utf-8"?>
<!-- Send Later Upcoming list (R35). Sections are filled by UpcomingActivity. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/sendlater_upcoming_disabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:background="#FFF3E0"
            android:text="@string/sendlater_upcoming_disabled"
            android:textColor="#5D4037"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/sendlater_upcoming_filter_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sendlater_upcoming_filtered"
                android:textSize="14sp" />

            <Button
                android:id="@+id/sendlater_upcoming_show_all"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sendlater_upcoming_show_all" />
        </LinearLayout>

        <TextView
            android:id="@+id/sendlater_upcoming_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/sendlater_upcoming_empty"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/sendlater_upcoming_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
