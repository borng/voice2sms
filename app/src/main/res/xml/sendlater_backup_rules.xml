<?xml version="1.0" encoding="utf-8"?>
<!-- sendlater:dl-privacy (OD31): Android 11 and older (android:fullBackupContent). Send Later's
     database (message texts, thread directory) and its sendlater_* prefs files stay on this
     phone: never in Google backup. D36: that includes the master switch (sendlater_switch), so a
     restored phone starts with Send Later off. Everything else in the app is backed up as before. -->
<full-backup-content>
    <exclude domain="database" path="sendlater.db" />
    <exclude domain="database" path="sendlater.db-wal" />
    <exclude domain="database" path="sendlater.db-shm" />
    <exclude domain="database" path="sendlater.db-journal" />
    <exclude domain="sharedpref" path="sendlater_engine.xml" />
    <exclude domain="sharedpref" path="sendlater_queue.xml" />
    <exclude domain="sharedpref" path="sendlater_listener.xml" />
    <exclude domain="sharedpref" path="sendlater_battery.xml" />
    <exclude domain="sharedpref" path="sendlater_settings_asked.xml" />
    <exclude domain="sharedpref" path="sendlater_retention.xml" />
    <exclude domain="sharedpref" path="sendlater_a11y.xml" />
    <exclude domain="sharedpref" path="sendlater_switch.xml" />
</full-backup-content>
