    <string name="sendlater_upcoming_title">Upcoming</string>
    <string name="sendlater_upcoming_section_pending">Pending</string>
    <string name="sendlater_upcoming_section_held">Held</string>
    <string name="sendlater_upcoming_section_recent">Recent (last 30 days)</string>
    <string name="sendlater_upcoming_empty">Nothing scheduled.</string>
    <string name="sendlater_upcoming_filtered">Showing one conversation</string>
    <string name="sendlater_upcoming_show_all">Show all</string>
    <string name="sendlater_upcoming_disabled">Send Later is off. Nothing will be sent until you turn it on in Settings.</string>
    <string name="sendlater_upcoming_unknown_recipient">Unknown recipient</string>
    <string name="sendlater_upcoming_change_time">Change time</string>
    <string name="sendlater_upcoming_cancel">Cancel</string>
    <string name="sendlater_upcoming_send_now">Send now</string>
    <string name="sendlater_upcoming_sending">Sending</string>
    <string name="sendlater_upcoming_confirm_cancel">Cancel this scheduled message?</string>
    <string name="sendlater_upcoming_confirm_send">Send this message now?</string>
    <string name="sendlater_upcoming_confirm_send_unverified">It may already have been sent. Send it now anyway?</string>
    <string name="sendlater_upcoming_keep">Keep</string>
    <string name="sendlater_upcoming_load_failed">Could not load scheduled messages.</string>

    <string name="sendlater_upcoming_reason_replied">Held: they replied</string>
    <string name="sendlater_upcoming_reason_reached_out">Held: they texted you</string>
    <string name="sendlater_upcoming_reason_outbound_only">Held: you texted them since scheduling</string>
    <string name="sendlater_upcoming_reason_unverified">Held: could not confirm whether it was sent</string>
    <string name="sendlater_upcoming_reason_locked">Held: the phone was locked</string>
    <string name="sendlater_upcoming_reason_unknown">Held</string>

