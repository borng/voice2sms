<?xml version="1.0" encoding="utf-8"?>
<!-- Send Later accent (A4, OD9): one light-blue token shared by the sheet, the edge tab and the
     chip. Mirrors com.voice2sms.sendlater.web.SendLaterAccent. -->
<resources>
    <color name="sendlater_accent">#8AB4F8</color>
    <color name="sendlater_on_accent">#0B1D3A</color>
    <color name="sendlater_accent_soft">#338AB4F8</color>
    <color name="sendlater_scrim">#66000000</color>
    <!-- UI M3: accent for TEXT and thin marks on the sheet's surface (text buttons, hints, picker
         buttons and dial). Light mode needs a dark blue for 4.5:1; values-night uses the light
         blue. Fills (tab, chip, Schedule button, picker chips) keep sendlater_accent. -->
    <color name="sendlater_accent_text">#1A4F9C</color>
    <color name="sendlater_on_accent_text">#FFFFFF</color>
    <!-- Battery indicator (R43, D28): one value for light and dark, since the setup wizard is
         always light and Settings follows the system. #1E8E3E: 4.2:1 on #FFFFFF, 4.5:1 on #121212,
         3.1:1 on #303030. #C26401: 4.1:1 / 4.6:1 / 3.2:1. White glyphs on them: 4.2:1 / 4.1:1. -->
    <color name="sendlater_battery_ok">#1E8E3E</color>
    <color name="sendlater_battery_warn">#C26401</color>
</resources>
