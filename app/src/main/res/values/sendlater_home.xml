    <string name="sendlater_about_what_title">What it does</string>
    <string name="sendlater_about_what_summary">voice2sms sends your texts through Google Voice: when it is your default texting app, when you ask Gemini to send a text, and when you send one from your watch. Send Later lets you schedule a text to go out at a time you pick.</string>
    <string name="sendlater_about_how_title">How to schedule a text</string>
    <string name="sendlater_about_how_summary">Open a conversation with one person and type your message. Then tap the blue clock tab on the right edge of the screen and pick a time.</string>
