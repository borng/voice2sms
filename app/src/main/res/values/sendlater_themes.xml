<?xml version="1.0" encoding="utf-8"?>
<!-- Own theme for the Send Later sheet (F2). The app theme is not touched. -->
<resources>
    <style name="Theme.SendLater.Sheet" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/sendlater_accent</item>
        <item name="colorOnPrimary">@color/sendlater_on_accent</item>
        <item name="colorSecondary">@color/sendlater_accent</item>
        <item name="colorOnSecondary">@color/sendlater_on_accent</item>
        <item name="colorPrimaryContainer">@color/sendlater_accent</item>
        <item name="colorOnPrimaryContainer">@color/sendlater_on_accent</item>
    </style>
</resources>
