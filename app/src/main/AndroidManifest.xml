<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />

    <!-- Needed on Android 13+ so the Wearable listener can post the BAL-fallback
         notification ("Send via Google Voice") when a watch send arrives.
         Runtime grant happens on first use; the listener also guards nm.notify()
         so a missing permission degrades gracefully instead of crashing. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Default-SMS-app permissions. These are auto-granted (GRANTED_BY_ROLE) when
         Voice2SMS holds android.app.role.SMS, but they MUST be declared here for
         the role grant to apply — otherwise the corresponding appops stay at the
         system default ("ignore"), which silently drops SMS_DELIVER before our
         SmsReceiver runs. Without these the carrier ACKs the message, the
         platform's raw-table row is cleared, and the SMS is permanently lost.
         Discovered 2026-05-27: prior versions declared none of these because
         Voice2SMS was send-only; the receiver stubs only existed to make the
         app appear in the default-SMS-app picker. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- sendlater:engine permissions -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- sendlater:voice-overlay start: optional, only improves R4 recipient resolution (A5) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- sendlater:voice-overlay end -->
    <!-- sendlater:battery-guard permission (R38: ignore-battery-optimizations request) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- sendlater:send-path permission (R30/OD10: full-screen intent opens the send on a locked screen) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- sendlater:dl-privacy start: the two backup-rule attributes on the application element below
         (OD31) keep sendlater.db and the sendlater_* prefs out of backup and device transfer. -->
    <!-- sendlater:dl-privacy end -->
    <application
        android:name=".Voice2SmsApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/sendlater_data_extraction_rules"
        android:fullBackupContent="@xml/sendlater_backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@android:drawable/sym_action_chat"
        android:label="@string/app_name"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">

        <!-- Launcher + SMS intent handler -->
        <activity
            android:name=".SmsHandlerActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">

            <!-- Launcher entry -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- SMS intent handling: ACTION_SENDTO -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>

            <!-- SMS intent handling: ACTION_VIEW -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>

            <!-- Share sheet: ACTION_SEND with text -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- WebView activity for Google Voice -->
        <activity
            android:name=".GVoiceWebViewActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.AppCompat.Light.DarkActionBar" />

        <!-- sendlater:send-path start -->
        <!-- OD10/OD11: no dedicated send activity and no foreground service. GVoiceWebViewActivity
             above is the lock-screen target: it sets showWhenLocked/turnScreenOn at runtime only
             for launches carrying ScheduledSendController.EXTRA_SCHEDULED_MESSAGE_ID. -->
        <!-- sendlater:send-path end -->

        <!-- Settings -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Voice2SMS.Settings" />

        <!-- sendlater:sheet-ui start -->
        <!-- Scheduling sheet (R12). Not exported: capture surfaces, the chip and notifications in
             this app start it through ACTION_CAPTURE / ACTION_EDIT with setPackage. -->
        <activity
            android:name=".sendlater.ui.SendLaterSheetActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.SendLater.Sheet"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="com.voice2sms.sendlater.action.CAPTURE" />
                <action android:name="com.voice2sms.sendlater.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- sendlater:sheet-ui end -->

        <!-- === Default SMS app stubs (required to appear in SMS app picker) === -->

        <!-- Stub: incoming SMS receiver -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- Stub: incoming MMS receiver -->
        <receiver
            android:name=".MmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Stub: respond-via-message service -->
        <service
            android:name=".RespondViaMessageService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- Gemini SMS interception via Accessibility Service -->
        <service
            android:name=".GeminiSmsInterceptService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/gemini_accessibility_config" />
        </service>

        <!-- sendlater:engine start -->
        <receiver
            android:name=".sendlater.engine.SendLaterAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".sendlater.engine.SendLaterBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".sendlater.engine.SendLaterActionReceiver"
            android:exported="false" />
        <!-- sendlater:engine end -->
        <!-- sendlater:dl-actions start -->
        <!-- L1 (OD31): Send now / Send anyway open this invisible activity, which acts only once
             the phone is unlocked (it is never shown over the keyguard). LIVE-F4 (all API
             levels): it starts the send from the foreground, so no accessibility is needed. -->
        <activity
            android:name=".sendlater.engine.SendLaterUnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- sendlater:dl-actions end -->

        <!-- First-install setup wizard -->
        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:theme="@style/Theme.Voice2SMS.Setup" />

        <!-- sendlater:upcoming-settings start -->
        <!-- Send Later Upcoming list (R35): Settings, the chip and notifications open it with
             SendLaterIntents.ACTION_UPCOMING (setPackage'd) and an optional EXTRA_E164 filter. -->
        <activity
            android:name=".sendlater.ui.UpcomingActivity"
            android:exported="false"
            android:label="@string/sendlater_upcoming_title"
            android:theme="@style/Theme.Voice2SMS.Settings">
            <intent-filter>
                <action android:name="com.voice2sms.sendlater.action.UPCOMING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- sendlater:upcoming-settings end -->
        <!-- sendlater:battery-guard start -->
        <!-- Once-a-day battery warning on the app-internal SCHEDULED broadcast (R39). -->
        <receiver
            android:name=".sendlater.battery.BatteryScheduledReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.voice2sms.sendlater.action.SCHEDULED" />
            </intent-filter>
        </receiver>
        <!-- sendlater:battery-guard end -->
        <!-- sendlater:live-a11y-warn start -->
        <!-- LIVE-F5: once-a-day warning when the accessibility service is off while a message is
             scheduled, on the app-internal SCHEDULED broadcast. -->
        <receiver
            android:name=".sendlater.a11y.A11yScheduledReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.voice2sms.sendlater.action.SCHEDULED" />
            </intent-filter>
        </receiver>
        <!-- sendlater:live-a11y-warn end -->

        <!-- Wearable listener: receives SMS send requests from the Voice2SMS watch companion.
             Transport is DataClient on /voice2sms/requests/* (durable) plus MessageClient on
             /voice2sms/requests/* (low-latency). Phone acks on /voice2sms/ack. See
             GALAXY-WATCH-SMS.md for the full protocol.

             exported="true" is REQUIRED: Google Play Services invokes WearableListenerService
             subclasses across UID boundary (GMS runs as its own UID), so the service must be
             exported. Cross-app forgery is prevented by the GMS Data Layer itself —
             DataClient items and MessageClient messages are scoped to matching applicationId
             on both paired devices. Only a Voice2SMS build signed with our keystore on the
             watch can reach this filter. -->
        <service
            android:name=".wear.WearSmsListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/voice2sms/requests/" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/voice2sms/requests/" />
            </intent-filter>
        </service>

        <!-- sendlater:reply-listener start -->
        <!-- Send Later reply detection (R32-R34): reads Google Voice and voice2sms incoming-SMS
             notifications; stores events only for conversations with a pending Send Later message. -->
        <service
            android:name=".sendlater.listener.SendLaterNotificationListener"
            android:label="@string/sendlater_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- sendlater:reply-listener end -->

    </application>

</manifest>
